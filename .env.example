# Supabase credentials (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Booking/payment mode: "manual" (default) or "stripe_test"
# Leave as "manual" unless Stripe test keys are fully configured.
# NEVER set to a live/production value — test mode only.
VITE_BOOKING_PAYMENT_MODE=manual

# ── Supabase Edge Function secrets (set via Supabase Dashboard > Edge Functions > Secrets) ──
# These are server-side only and must NEVER be placed in frontend .env files.

# Stripe TEST MODE secret key (sk_test_...)
# STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret for the Supabase edge function endpoint (whsec_...)
# STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of this site, used for Stripe redirect URLs
# SITE_URL=https://your-site.com

# Stripe Checkout session expiration in minutes (default: 30)
# STRIPE_CHECKOUT_EXPIRES_MINUTES=30
